VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO memristor
  CLASS CORE ;
  SIZE 1.0 BY 1.0 ;
  SYMMETRY X Y ;
  PIN BE
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER BE ;
      RECT 0.0 0.0 1.0 0.2 ;
    END
  END BE
  PIN TE
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TE ;
      RECT 0.0 0.8 1.0 1.0 ;
    END
  END TE
END memristor
MACRO crossbar2x2_tio2_au
  CLASS CORE ;
  SIZE 9.0 BY 9.0 ;
  SYMMETRY X Y ;
  PIN BE1
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER BE ;
      RECT 0.0 2.0 9.0 3.0 ;
    END
  END BE1
  PIN BE2
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER BE ;
      RECT 0.0 6.0 9.0 7.0 ;
    END
  END BE2
  PIN TE1
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TE ;
      RECT 2.0 0.0 3.0 9.0 ;
    END
  END TE1
  PIN TE2
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TE ;
      RECT 6.0 0.0 7.0 9.0 ;
    END
  END TE2
END crossbar2x2_tio2_au
MACRO crossbar4x4_tio2_au
  CLASS CORE ;
  SIZE 17.0 BY 17.0 ;
  SYMMETRY X Y ;
  PIN BE1
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER BE ;
      RECT 0.0 2.0 17.0 3.0 ;
    END
  END BE1
  PIN BE2
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER BE ;
      RECT 0.0 6.0 17.0 7.0 ;
    END
  END BE2
  PIN BE3
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER BE ;
      RECT 0.0 10.0 17.0 11.0 ;
    END
  END BE3
  PIN BE4
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER BE ;
      RECT 0.0 14.0 17.0 15.0 ;
    END
  END BE4
  PIN TE1
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TE ;
      RECT 2.0 0.0 3.0 17.0 ;
    END
  END TE1
  PIN TE2
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TE ;
      RECT 6.0 0.0 7.0 17.0 ;
    END
  END TE2
  PIN TE3
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TE ;
      RECT 10.0 0.0 11.0 17.0 ;
    END
  END TE3
  PIN TE4
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER TE ;
      RECT 14.0 0.0 15.0 17.0 ;
    END
  END TE4
END crossbar4x4_tio2_au
